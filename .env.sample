# Every crowsnest environment variable, with no values. Copy to .env (gitignored) and fill in
# what you need; flags and ~/.config/crowsnest/config.yaml work too. See README.md.

# ---- Login (one of these two is required) ----
CROWSNEST_USERNAME=
CROWSNEST_PASSWORD=
CROWSNEST_PASSWORD_FILE=
CROWSNEST_NO_AUTH=
# SUPPRESS_AUTH=true is also honoured as --no-auth, but only on a localhost-only bind

# ---- Network ----
CROWSNEST_BIND=
CROWSNEST_PORT=
CROWSNEST_ALLOWED_HOSTS=
CROWSNEST_TRUSTED_PROXY=
CROWSNEST_TRUSTED_PROXY_HEADER=
CROWSNEST_TLS_CERT=
CROWSNEST_TLS_KEY=
CROWSNEST_I_KNOW_THIS_IS_OPEN=

# ---- herdr and the orchestrator ----
CROWSNEST_SESSION=
CROWSNEST_ALLOW_DEFAULT_SESSION=
CROWSNEST_DIR=
# CROWSNEST_MODEL=sonnet is the default; set it EMPTY (CROWSNEST_MODEL=) only to mean Claude's own
# default, so it is commented out here rather than left blank.
# CROWSNEST_MODEL=sonnet
CROWSNEST_JOB_MODEL=
CROWSNEST_PERMISSION_MODE=
CROWSNEST_POKE_INTERVAL=
CROWSNEST_NO_ORCHESTRATOR=
CROWSNEST_ENGINE=
CROWSNEST_OPEN=
CROWSNEST_NO_TAILSCALE_DETECT=
CROWSNEST_NAME=
CROWSNEST_NO_REMOTE_CONTROL=
CROWSNEST_JOB_REMOTE_CONTROL=
CROWSNEST_COMPACT_AT=
CROWSNEST_FRESH_AT=
CROWSNEST_ATTACHMENT_MAX_MB=
CROWSNEST_ATTACHMENT_QUOTA_MB=
CROWSNEST_PROTECTED_HOSTS=
CROWSNEST_PROTECTED_HOSTS_FILE=
CROWSNEST_PROTECTED_BRANCHES=
CROWSNEST_TERMINAL_MACHINES=
CROWSNEST_TAILSCALE_AUTH=
CROWSNEST_BACKUP_EVERY=
CROWSNEST_BACKUP_KEEP=
CROWSNEST_ARCHIVE_AFTER_DAYS=
CROWSNEST_DELETE_AFTER_DAYS=
CROWSNEST_DEMO=

# ---- Talk mode and notices ----
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_FILE=
CROWSNEST_ELEVENLABS_VOICE=
CROWSNEST_ELEVENLABS_URL=
CROWSNEST_NOTIFY_URL=
CROWSNEST_NOTIFY_URL_FILE=

# ---- Paths ----
CROWSNEST_DATA_DIR=
CROWSNEST_CONFIG=

# ---- Development ----
CROWSNEST_WEB_DEV=
