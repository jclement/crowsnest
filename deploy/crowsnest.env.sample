# Copy to deploy/crowsnest.env (gitignored) and fill in. Keys only here; never commit values.
# Every crowsnest flag has a CROWSNEST_* variable (DESIGN.md section 3, README Configuration).
#
# This file is crowsnest's alone. Sidecar tokens (TUNNEL_TOKEN, TS_AUTHKEY) go in the sidecar's
# own file (cloudflared.env, tailscale.env; see compose.yaml): anything in this file is in the
# crowsnest container's PID 1 environment, which every agent can read (R1b N1).

# Login. Required unless both CROWSNEST_NO_AUTH=true and CROWSNEST_I_KNOW_THIS_IS_OPEN=true.
CROWSNEST_USERNAME=
# The password: preferably as a file (compose.yaml mounts deploy/crowsnest_password as a secret
# and sets CROWSNEST_PASSWORD_FILE). CROWSNEST_PASSWORD here works too, but an agent in the
# container can read it from /proc/1/environ.
# CROWSNEST_PASSWORD=

# Optional.
# CROWSNEST_SESSION=crowsnest
# CROWSNEST_MODEL=
# CROWSNEST_ALLOWED_HOSTS=crowsnest.example.ts.net
# With a tunnel or tailscale serve sharing crowsnest's network namespace (compose.yaml):
# CROWSNEST_TRUSTED_PROXY=loopback
# For the cloudflared tunnel only (tailscale serve keeps the default, x-forwarded-for):
# CROWSNEST_TRUSTED_PROXY_HEADER=cf-connecting-ip
# These two, set as variables, are readable by agents through /proc/1/environ. Prefer the file
# forms (mount the files as compose secrets, as the password is): the files are still readable
# by the same uid, but they stay out of every process's environment.
# CROWSNEST_NOTIFY_URL=
# CROWSNEST_NOTIFY_URL_FILE=/run/secrets/crowsnest_notify_url
# ELEVENLABS_API_KEY=
# ELEVENLABS_API_KEY_FILE=/run/secrets/elevenlabs_api_key
# How long the entrypoint waits for `mise install` before starting anyway (seconds).
# CROWSNEST_MISE_WAIT=300
