# Copy to deploy/.env (gitignored) and fill in. Keys only here; never commit values.
# Every crowsnest flag has a CROWSNEST_* variable (DESIGN.md section 3, README Configuration).

# Login. Required unless both CROWSNEST_NO_AUTH=true and CROWSNEST_I_KNOW_THIS_IS_OPEN=true.
CROWSNEST_USERNAME=
# Either the password itself, or a file holding it (first line), e.g. a mounted Docker secret.
CROWSNEST_PASSWORD=
# CROWSNEST_PASSWORD_FILE=/run/secrets/crowsnest_password

# Optional.
# CROWSNEST_SESSION=crowsnest
# CROWSNEST_MODEL=
# CROWSNEST_ALLOWED_HOSTS=crowsnest.example.ts.net
# CROWSNEST_NOTIFY_URL=
# ELEVENLABS_API_KEY=
# How long the entrypoint waits for `mise install` before starting anyway (seconds).
# CROWSNEST_MISE_WAIT=300

# For the cloudflared sidecar in compose.yaml, if you use it.
# TUNNEL_TOKEN=
# For the tailscale sidecar in compose.yaml, if you use it.
# TS_AUTHKEY=
