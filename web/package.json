{
  "name": "crowsnest-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "e2e": "playwright test --project=desktop-chromium --project=mobile-chromium --project=mobile-webkit",
    "e2e:real": "playwright test -c playwright.real.config.ts",
    "e2e:claude": "playwright test -c playwright.claude.config.ts",
    "e2e:voice": "playwright test --project=desktop-chromium --project=mobile-webkit e2e/hermetic/talk.spec.ts",
    "screenshots": "playwright test -c playwright.fixtures.config.ts",
    "screenshots:chat": "playwright test --project=screenshots e2e/screenshots/chat.spec.ts",
    "screenshots:inbox": "playwright test --project=screenshots e2e/screenshots/inbox.spec.ts",
    "screenshots:jobs": "playwright test --project=screenshots e2e/screenshots/jobs.spec.ts",
    "screenshots:palette": "playwright test --project=screenshots e2e/screenshots/palette.spec.ts",
    "screenshots:manual": "playwright test --project=screenshots e2e/screenshots/manual.spec.ts",
    "screenshots:themes": "playwright test --project=screenshots e2e/screenshots/themes.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "diff": "9.0.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.80.0",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@fontsource/dejavu-mono": "5.3.0",
    "@fontsource/noto-sans-math": "5.3.0",
    "@fontsource/noto-sans-symbols-2": "5.3.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/hast": "3.0.5",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
