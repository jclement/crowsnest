# Build output
/bin/
/dist/
/coverage.out
/coverage.html

# Web: dependencies and build output (dist keeps a placeholder so //go:embed always has a file)
web/node_modules/
web/dist/*
!web/dist/.gitkeep
web/coverage/
web/test-results*/
web/playwright-report/

# Local state and secrets
/.dev/
.env
deploy/*.env
deploy/crowsnest_password
mise.local.toml
*.db
*.db-shm
*.db-wal

# Agent report for the lead; not part of the repo
/REPORT.md

.DS_Store

# Real-Claude smoke test working directories (removed by the test; ignored in case it is killed)
internal/orch/e2e-orchestrator-*/

# Real-Claude browser suite scratch repos (removed by the suite; ignored in case it is killed)
web/e2e/claude/.scratch-*/
web/e2e/claude/captured/
# a stray build output at the repo root (go build ./cmd/crowsnest); the real one is bin/crowsnest
/crowsnest
# agent worktrees must never live inside the checkout
/.claude/

# The per-view tour shots (e2e/screenshots/tour.spec.ts); only the before/after sheet is committed
web/screenshots/tour/
